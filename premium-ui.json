{
  "profile": "product-admin",
  "sourceRoots": ["apps/web/src"],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Scrollbar"],
  "requiredCommands": ["unit", "typecheck", "build", "tokens", "e2e"],
